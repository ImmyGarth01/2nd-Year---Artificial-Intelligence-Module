# Non Recursive DFS
def dfs_non_recursive(graph, start):
    visited = set()
    #Instead of recursion we are going to use queue to track traversal
    queue = [start]

    while queue:
        node = queue.pop()#Get the last element that was inserted
        # Last in First Out LIFO
        if node not in visited:
            print(node)
            visited.add(node)
            queue.extend(reversed(graph[node]))

    dfs_non_recursive(graph, "5")
