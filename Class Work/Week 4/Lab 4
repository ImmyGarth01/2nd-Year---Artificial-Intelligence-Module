#3.  design a DFS function with the inputs as visited nodes, the graph 
# itself and the starting (vertex) node 

def dfs(visited, graph, node):
    # check whether any node of the graph is visited or not
    if node not in visited:
        #print the node and add it to the visited set of nodes
        print(node)
        visited.add(node)
        #go to the neighboring nodes and again call the DFS function to check
        for neighbour in graph[node]:
            dfs(visited, graph, neighbour)
        
visited = set()
