# Step 2 - Defining agent movement 
# I want to not just use North, South, East, West but also the Diagonals (NE,NW,SE,SW)

def get_neighbors(state):

    row, column = state

    North = (-1, 0)
    South = (1, 0)
    East = (0, 1)
    West = (0, -1)
    North_East = (-1, 1)
    North_West = (-1, -1)
    South_East = (1, 1)
    South_West = (1, -1)

    moves = [North, South, East, West, North_East, North_West, South_East, South_West]

    neighbors = []

    for move in moves:

        dr, dc = move
        new_row, new_column = row + dr, column + dc

        if (0 <= new_row < len(SuttonLondonGrid) and
            0 <= new_column < len(SuttonLondonGrid[0])):

            cell = SuttonLondonGrid[new_row][new_column]

            if cell == '-':
                cost = 2
            elif cell == 'C':
                cost = 5
            elif cell == 'H':
                cost = 0
            else:
                cost = 2

            neighbors.append(((new_row,new_column), cost))

    return neighbors


